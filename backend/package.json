{
  "name": "estateflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production backend API for EstateFlow",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "test:watch": "node --test --watch",
    "test:integration": "node scripts/apiIntegrationCheck.js",
    "seed": "node seeders/index.js",
    "seed:demo": "node seeders/demo.js",
    "seed:admin": "node scripts/createAdmin.js",
    "deploy:check": "node scripts/deploymentPreflight.js",
    "db:indexes": "node scripts/createIndexes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "validator": "^13.15.15",
    "winston": "^3.17.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^16.3.0",
    "supertest": "^7.1.4"
  }
}
