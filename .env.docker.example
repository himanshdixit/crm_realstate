MONGO_ROOT_USERNAME=crm_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-mongodb-password
DB_NAME=Codex_realstate_db
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20
MONGODB_MAX_IDLE_TIME_MS=60000

ACCESS_TOKEN_SECRET=replace-with-a-random-access-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

FRONTEND_PORT=3000
BACKEND_PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EstateFlow
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
LOG_LEVEL=info

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=EstateFlow <no-reply@example.com>
